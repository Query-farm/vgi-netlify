acme-web	CMS publish	api.netlify.com

query I
SELECT count(*) FROM (SELECT to_json(h)::VARCHAR AS j FROM netlify.main.hooks h UNION ALL SELECT to_json(b)::VARCHAR FROM netlify.main.build_hooks b) WHERE j LIKE '%SECRET%' OR j LIKE '%@%';
----
0

