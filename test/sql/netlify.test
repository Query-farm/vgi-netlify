query ITTT
SELECT number, site_url, email, body FROM netlify.main.form_submissions('form-contact') ORDER BY number;
----
1	https://www.acme.dev	NULL	NULL
2	https://www.acme.dev	NULL	NULL
3	https://www.acme.dev	NULL	NULL
4	https://www.acme.dev	NULL	NULL
5	https://www.acme.dev	NULL	NULL

query ITT
SELECT number, email, data->>'message' FROM netlify.main.form_submissions('form-contact', include_contents := true) WHERE number = 5;
----
5	eve@example.com	What does it cost?

query I
SELECT count(*) FROM netlify.main.form_submissions('no-such-form');
----
0

# --------------------------------------------------------------------- functions

query TTTI
SELECT site, name, runtime, size_bytes FROM netlify.main.functions ORDER BY site, name;
----
acme-docs	search	js	20480
acme-web	checkout	js	102400
acme-web	image-resize	go	4096000

# ---------------------------------------------------------------------------- DNS

# The first /dns_zones request answers 429 + Retry-After; the client waits and retries.
query TTII
SELECT name, dns_servers[1], record_count, len(errors) FROM netlify.main.dns_zones ORDER BY name;
----
acme.dev	dns1.p01.nsone.net	5	0
acme.io	dns3.p01.nsone.net	1	1

query I
SELECT count(*) FROM read_json('{NETLIFY_FIXTURE_URL}/__requests?path=/api/v1/dns_zones');
----
2

query TTTTII
SELECT domain, id, name, type, ttl, mx_priority FROM netlify.main.dns_records ORDER BY domain, id;
----
acme.dev	rec-1	(empty)	NETLIFY	3600	NULL
acme.dev	rec-2	www	NETLIFY	3600	NULL
acme.dev	rec-3	(empty)	MX	3600	10
acme.dev	rec-4	(empty)	CAA	3600	NULL
acme.dev	rec-5	_dmarc	TXT	300	NULL
acme.io	rec-6	(empty)	A	3600	NULL

query T
SELECT value FROM netlify.main.dns_records WHERE domain = 'acme.io';
----
75.2.60.5

query T
SELECT tag FROM netlify.main.dns_records WHERE zone_id = 'zone-acme-dev' AND type = 'CAA';
----
issue

# ---------------------------------------------------------------- ssl_certificates

# hobby-blog has no certificate (404) → no row.
query TTT
SELECT site, state, expires_at FROM netlify.main.ssl_certificates ORDER BY expires_at;
----
acme-web	issued	2026-11-30 00:00:00+00
acme-docs	issued	2026-12-30 00:00:00+00

# ------------------------------------------------------------------ env_var_names

query TTTTTI
SELECT project, key, targets, type, git_branch, value_count FROM netlify.main.env_var_names ORDER BY project, key;
----
acme-docs	PUBLIC_API_URL	[production]	plain	NULL	1
acme-web	FEATURE_FLAG	[preview, development]	plain	beta	2
acme-web	PUBLIC_API_URL	[production, preview, development]	plain	NULL	1
acme-web	STRIPE_SECRET_KEY	[production, preview]	secret	NULL	2

# Values are never emitted, secret or not.
query I
SELECT count(*) FROM (SELECT to_json(e)::VARCHAR AS j FROM netlify.main.env_var_names e) WHERE j LIKE '%ENV_VALUE_SECRET%' OR j LIKE '%sk_%';
----
0

query I
SELECT count(*) FROM netlify.main.env_var_names WHERE project_id = 'site-0002-acme-docs';
----
1

query T
SELECT query FROM read_json('{NETLIFY_FIXTURE_URL}/__requests?path=/api/v1/accounts/acc0acme000000000000001/env') ORDER BY seq DESC LIMIT 1;
----
{"site_id": "site-0002-acme-docs"}

