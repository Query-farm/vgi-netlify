# --------------------------------------------------------------------- audit_events

# grace's plan has no audit log (403) → no rows, not an error.
query TTT
SELECT account_slug, actor_name, action FROM netlify.main.audit_events WHERE timestamp >= TIMESTAMPTZ '2026-11-01 00:00:00+00' ORDER BY timestamp;
----
acme	Ada Lovelace	member.invited
acme	Grace Hopper	env_var.updated
acme	Ada Lovelace	deploy.locked

query TT
SELECT action, payload->>'key' FROM netlify.main.audit_events WHERE account_id = 'acc0acme000000000000001' AND log_type = 'audit' AND action = 'env_var.updated';
----
env_var.updated	PUBLIC_API_URL

query T
SELECT query::JSON->>'log_type' FROM read_json('{NETLIFY_FIXTURE_URL}/__requests?path=/api/v1/accounts/acc0acme000000000000001/audit') ORDER BY seq DESC LIMIT 1;
----
audit

query I
SELECT count(*) FROM netlify.main.audit_events WHERE log_type = 'security';
----
1

# ------------------------------------------------------------------ unified.runs

query TT
SELECT column_name, column_type FROM (DESCRIBE netlify.unified.runs);
----
orchestrator	VARCHAR
run_id	VARCHAR
pipeline	VARCHAR
status	VARCHAR
raw_status	VARCHAR
trigger	VARCHAR
queued_at	TIMESTAMP WITH TIME ZONE
started_at	TIMESTAMP WITH TIME ZONE
ended_at	TIMESTAMP WITH TIME ZONE
duration_seconds	DOUBLE
url	VARCHAR

query TI
SELECT status, count(*) FROM netlify.unified.runs GROUP BY status ORDER BY status;
----
cancelled	10
failed	26
queued	1
running	1
skipped	1
success	215

query TTTT
SELECT orchestrator, pipeline, status, trigger FROM netlify.unified.runs WHERE pipeline = 'hobby-blog';
----
netlify	hobby-blog	success	manual

query I
SELECT count(*) FROM netlify.unified.runs WHERE pipeline = 'acme-docs' AND status = 'failed';
----
1

query T
SELECT query FROM read_json('{NETLIFY_FIXTURE_URL}/__requests?path=/api/v1/sites/site-0002-acme-docs/deploys') ORDER BY seq DESC LIMIT 2;
----
{"page": "1", "per_page": "100", "state": "rejected"}
{"page": "1", "per_page": "100", "state": "error"}

# --------------------------------------------------------- strict replay

# Every request the worker made carried only documented parameters (an unknown one is a
# 422) — the only non-200 answers are the deliberate 401 / 429 / 403 / 404 cases.
query TI
SELECT status, count(*) > 0 FROM read_json('{NETLIFY_FIXTURE_URL}/__requests?prefix=/api/v1/') GROUP BY status ORDER BY status;
----
200	true
401	true
403	true
404	true
429	true

statement ok
DETACH netlify;
