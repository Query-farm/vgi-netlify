# name: test/sql/netlify.test
# description: SQL tests for the netlify worker against the offline Netlify replay server (test/mock_api/server.py)
# group: [netlify]

require vgi

require-env NETLIFY_WORKER

require-env NETLIFY_FIXTURE_URL

# httpfs + json read the replay server's /__requests log to assert what was pushed down.
statement ok
LOAD httpfs;

statement ok
LOAD json;

statement ok
ATTACH 'netlify' (TYPE vgi, LOCATION '{NETLIFY_WORKER}');

# ---------------------------------------------------------------- secret errors

statement error
SELECT count(*) FROM netlify.main.sites;
----
<REGEX>:.*no netlify secret.*

statement ok
CREATE SECRET netlify_bad (TYPE netlify, TOKEN 'wrong-token', BASE_URL '{NETLIFY_FIXTURE_URL}/api/v1');

statement error
SELECT count(*) FROM netlify.main.sites;
----
<REGEX>:.*HTTP 401.*Access Denied.*

statement ok
DROP SECRET netlify_bad;

statement ok
CREATE SECRET netlify_insecure (TYPE netlify, TOKEN 'x', BASE_URL 'http://api.netlify.com/api/v1');

statement error
SELECT count(*) FROM netlify.main.sites;
----
<REGEX>:.*https.*

statement ok
DROP SECRET netlify_insecure;

statement ok
CREATE SECRET netlify_fixture (TYPE netlify, TOKEN 'test-token', BASE_URL '{NETLIFY_FIXTURE_URL}/api/v1');

# ---------------------------------------------------------------------- accounts

query TTTII
SELECT id, slug, type_name, sites_used, collaborators_used FROM netlify.main.accounts ORDER BY slug;
----
acc0acme000000000000001	acme	Pro	2	3
acc0personal0000000002	grace	Starter	1	1

# ------------------------------------------------------------------------- sites

query TTTTTTTT
SELECT name, custom_domain, repo, repo_provider, production_branch, build_command, publish_dir, framework FROM netlify.main.sites ORDER BY name;
----
acme-docs	docs.acme.dev	acme/docs	gitlab	trunk	hugo	public	hugo
acme-web	www.acme.dev	acme/web	github	main	npm run build	dist	astro
hobby-blog	NULL	NULL	NULL	NULL	NULL	NULL	NULL

query TTTTT
SELECT name, ssl, force_ssl, managed_dns, password_protected FROM netlify.main.sites ORDER BY name;
----
acme-docs	true	false	false	true
acme-web	true	true	true	false
hobby-blog	true	true	false	false

query T
SELECT published_deploy_id FROM netlify.main.sites WHERE name = 'acme-web';
----
665000000000000000000002

# name = '…' is pushed into the list call; the SDK keeps the exact match.
query T
SELECT query::JSON->>'name' FROM read_json('{NETLIFY_FIXTURE_URL}/__requests?path=/api/v1/sites') ORDER BY seq DESC LIMIT 1;
----
acme-web

# account_slug switches to GET /{account_slug}/sites.
query T
SELECT name FROM netlify.main.sites WHERE account_slug = 'grace';
----
hobby-blog

query I
SELECT count(*) FROM read_json('{NETLIFY_FIXTURE_URL}/__requests?path=/api/v1/grace/sites');
----
1

# No secret ever reaches a column: site password, deploy hook, build env values.
query I
SELECT count(*) FROM (SELECT to_json(s)::VARCHAR AS j FROM netlify.main.sites s) WHERE j LIKE '%SECRET%';
----
0

# ---------------------------------------------------------------------- projects

query TTTTTTTT
SELECT platform, name, framework, repo, repo_provider, production_branch, root_directory, production_url FROM netlify.main.projects ORDER BY name;
----
netlify	acme-docs	hugo	acme/docs	gitlab	trunk	site	https://docs.acme.dev
netlify	acme-web	astro	acme/web	github	main	NULL	https://www.acme.dev
netlify	hobby-blog	NULL	NULL	NULL	NULL	NULL	https://hobby-blog.netlify.app

# ----------------------------------------------------------------------- domains

query TTT
SELECT project, domain, kind FROM netlify.main.domains ORDER BY project, domain;
----
acme-docs	acme-docs.netlify.app	netlify_subdomain
acme-docs	docs.acme.dev	primary
acme-web	acme-web.netlify.app	netlify_subdomain
acme-web	acme.dev	alias
acme-web	acme.io	alias
acme-web	branches.acme.dev	branch_deploy
acme-web	www.acme.dev	primary
hobby-blog	hobby-blog.netlify.app	netlify_subdomain

# ------------------------------------------------------------------- deployments

# The shared web-deploy vocabulary: these 16 columns in this order.
query TT
SELECT column_name, column_type FROM (DESCRIBE netlify.main.deployments) LIMIT 16;
----
platform	VARCHAR
id	VARCHAR
project	VARCHAR
environment	VARCHAR
state	VARCHAR
raw_state	VARCHAR
branch	VARCHAR
commit_sha	VARCHAR
commit_message	VARCHAR
creator	VARCHAR
created_at	TIMESTAMP WITH TIME ZONE
building_at	TIMESTAMP WITH TIME ZONE
ready_at	TIMESTAMP WITH TIME ZONE
build_duration_seconds	DOUBLE
url	VARCHAR
inspector_url	VARCHAR

# Every deploy of every site; acme-web's 250 deploys take three pages.
query TTI
SELECT project, state, count(*) FROM netlify.main.deployments GROUP BY ALL ORDER BY ALL;
----
acme-docs	error	1
acme-docs	ready	2
acme-web	building	1
acme-web	canceled	11
acme-web	error	25
acme-web	queued	1
acme-web	ready	212
hobby-blog	ready	1

query I
SELECT count(*) FROM read_json('{NETLIFY_FIXTURE_URL}/__requests?path=/api/v1/sites/site-0001-acme-web/deploys') WHERE query = '{"page": "3", "per_page": "100"}';
----
1

# Pushdown: environment + state + one site → production=true&state=ready on that site only.
query TIR
SELECT project, count(*), round(avg(build_duration_seconds), 2) FROM netlify.main.deployments WHERE project = 'acme-web' AND environment = 'production' AND state = 'ready' GROUP BY project;
----
acme-web	119	74.79

query T
SELECT query FROM read_json('{NETLIFY_FIXTURE_URL}/__requests?path=/api/v1/sites/site-0001-acme-web/deploys') ORDER BY seq DESC LIMIT 1;
----
{"page": "2", "per_page": "100", "production": "true", "state": "ready"}

# The site was found by name, not by listing every site.
query T
SELECT query::JSON->>'name' FROM read_json('{NETLIFY_FIXTURE_URL}/__requests?path=/api/v1/sites') ORDER BY seq DESC LIMIT 1;
----
acme-web

# state = 'error' covers two raw states (error, rejected): one request each.
query I
SELECT count(*) FROM netlify.main.deployments WHERE project_id = 'site-0001-acme-web' AND state = 'error' AND branch = 'beta';
----
13

query T
SELECT list(query::JSON->>'state' ORDER BY seq) FROM (SELECT * FROM read_json('{NETLIFY_FIXTURE_URL}/__requests?path=/api/v1/sites/site-0001-acme-web/deploys') ORDER BY seq DESC LIMIT 2);
----
[error, rejected]

query T
SELECT DISTINCT query::JSON->>'branch' FROM (SELECT * FROM read_json('{NETLIFY_FIXTURE_URL}/__requests?path=/api/v1/sites/site-0001-acme-web/deploys') ORDER BY seq DESC LIMIT 2);
----
beta

# canceled comes from error_message, not from state: nothing is pushed, still exact.
query I
SELECT count(*) FROM netlify.main.deployments WHERE project_id = 'site-0001-acme-web' AND state = 'canceled';
----
11

# A created_at lower bound stops paging early: deploys are newest first, so the first
# page already passes 2026-11-01 and page 2 is never requested.
query I
SELECT count(*) FROM netlify.main.deployments WHERE project = 'acme-web' AND created_at >= TIMESTAMPTZ '2026-11-01 00:00:00+00';
----
55

query I
SELECT max((query::JSON->>'page')::INT) FROM (SELECT * FROM read_json('{NETLIFY_FIXTURE_URL}/__requests?path=/api/v1/sites/site-0001-acme-web/deploys') ORDER BY seq DESC LIMIT 1);
----
1

# Derived timings and URLs of one finished deploy.
query TTTTTRT
SELECT id, environment, state, commit_message, creator, build_duration_seconds, url FROM netlify.main.deployments WHERE project_id = 'site-0002-acme-docs' AND id = 'docs00000000000000000001';
----
docs00000000000000000001	production	ready	Add search page	Grace	55.0	https://docs00000000000000000001--acme-docs.netlify.app

query TTT
SELECT ready_at, building_at, inspector_url FROM netlify.main.deployments WHERE project_id = 'site-0002-acme-docs' AND id = 'docs00000000000000000001';
----
2026-11-10 08:01:00+00	2026-11-10 08:00:05+00	https://app.netlify.com/sites/acme-docs/deploys/docs00000000000000000001

# Unknown site → no rows, not an error.
query I
SELECT count(*) FROM netlify.main.deployments WHERE project_id = 'no-such-site';
----
0

# ------------------------------------------------------------------------ deploy

query TTTITT
SELECT id, state, summary_status, function_count, function_names, function_schedules FROM netlify.main.deploy('docs00000000000000000001');
----
docs00000000000000000001	ready	ready	1	[search]	[{'name': reindex, 'cron': @daily}]

query I
SELECT count(*) FROM netlify.main.deploy('nope');
----
0

