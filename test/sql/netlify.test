bld-docs-1	docs00000000000000000001	true
bld-docs-2	docs00000000000000000002	true

query II
SELECT count(*), count(*) FILTER (WHERE error IS NOT NULL) FROM netlify.main.builds WHERE site_id = 'site-0001-acme-web';
